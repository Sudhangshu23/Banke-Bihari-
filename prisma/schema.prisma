datasource db { provider = "mysql"
  url = env("DATABASE_URL") }
generator client { provider = "prisma-client-js" }
enum Role { ADMIN KITCHEN WAITER POS }
enum OrderStatus { NEW ACCEPTED PREPARING READY SERVED CANCELLED }
enum TableStatus { AVAILABLE OCCUPIED PREPARING NEEDS_CLEANING RESERVED UNAVAILABLE }
model User { id Int @id @default(autoincrement())
  username String @unique
  passwordHash String
  role Role
  active Boolean @default(true)
  audits AuditLog[] }
model DiningTable { id Int @id @default(autoincrement())
  number Int @unique
  seats Int @default(4)
  status TableStatus @default(AVAILABLE)
  qrTokens QrToken[]
  orders Order[]
  bookings Booking[] }
model QrToken { id Int @id @default(autoincrement())
  token String @unique
  tableId Int
  active Boolean @default(true)
  table DiningTable @relation(fields:[tableId],references:[id])
  @@index([tableId]) }
model Category { id Int @id @default(autoincrement())
  name String @unique
  items MenuItem[] }
model MenuItem { id Int @id @default(autoincrement())
  name String
  description String?
  imageUrl String?
  categoryId Int
  price Decimal @db.Decimal(10,2)
  veg Boolean @default(true)
  available Boolean @default(true)
  prepMinutes Int?
  gstPercent Decimal @default(5) @db.Decimal(5,2)
  category Category @relation(fields:[categoryId],references:[id])
  addons Addon[]
  orderItems OrderItem[]
  recipe Recipe[]
  @@index([categoryId]) }
model Addon { id Int @id @default(autoincrement())
  menuItemId Int
  name String
  price Decimal @db.Decimal(10,2)
  item MenuItem @relation(fields:[menuItemId],references:[id]) }
model Supplier { id Int @id @default(autoincrement())
  name String
  phone String? }
model Ingredient { id Int @id @default(autoincrement())
  name String
  unit String
  stock Decimal @db.Decimal(12,3)
  lowStockAt Decimal @db.Decimal(12,3)
  recipe Recipe[] }
model Recipe { id Int @id @default(autoincrement())
  menuItemId Int
  ingredientId Int
  qty Decimal @db.Decimal(12,3)
  item MenuItem @relation(fields:[menuItemId],references:[id])
  ingredient Ingredient @relation(fields:[ingredientId],references:[id]) }
model Order { id Int @id @default(autoincrement())
  tableId Int?
  status OrderStatus @default(NEW)
  total Decimal @db.Decimal(12,2)
  createdAt DateTime @default(now())
  table DiningTable? @relation(fields:[tableId],references:[id])
  items OrderItem[]
  history OrderStatusHistory[]
  payments Payment[]
  invoice Invoice?
  @@index([status]) }
model OrderItem { id Int @id @default(autoincrement())
  orderId Int
  menuItemId Int
  qty Int
  unitPrice Decimal @db.Decimal(10,2)
  note String?
  order Order @relation(fields:[orderId],references:[id])
  item MenuItem @relation(fields:[menuItemId],references:[id]) }
model OrderStatusHistory { id Int @id @default(autoincrement())
  orderId Int
  status OrderStatus
  at DateTime @default(now())
  byUser String?
  order Order @relation(fields:[orderId],references:[id]) }
model Payment { id Int @id @default(autoincrement())
  orderId Int
  method String
  amount Decimal @db.Decimal(12,2)
  providerRef String?
  verified Boolean @default(false)
  at DateTime @default(now())
  order Order @relation(fields:[orderId],references:[id]) }
model Invoice { id Int @id @default(autoincrement())
  orderId Int @unique
  number String @unique
  cgst Decimal @db.Decimal(12,2)
  sgst Decimal @db.Decimal(12,2)
  order Order @relation(fields:[orderId],references:[id]) }
model Booking { id Int @id @default(autoincrement())
  tableId Int
  name String
  phone String
  at DateTime
  table DiningTable @relation(fields:[tableId],references:[id]) }
model Review { id Int @id @default(autoincrement())
  orderId Int
  rating Int
  comment String? }
model AuditLog { id Int @id @default(autoincrement())
  userId Int?
  action String
  detail String?
  at DateTime @default(now())
  user User? @relation(fields:[userId],references:[id]) }
